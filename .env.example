# Окружение приложения (не коммитить реальный .env).
APP_ENV=test
APP_PORT=8000
COOKIE_SECURE=false

# Параметры PostgreSQL для docker compose.
POSTGRES_DB=studentledger
POSTGRES_USER=studentledger
POSTGRES_PASSWORD=replace-with-strong-password

# Не менее 32 символов. Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-with-at-least-32-random-characters

# Для локального запуска без compose (необязательно):
# DATABASE_URL=postgresql+psycopg://studentledger:password@127.0.0.1:5432/studentledger
